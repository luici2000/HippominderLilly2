import SwiftUI\
import PhotosUI\
\
struct HippominderDetailView: View \{\
    @Bindable var horse: Horse\
\
    @State private var notificationDaysBefore: Int = 3\
    @State private var selectedPhoto: PhotosPickerItem?\
    @State private var horseImage: Image?\
    @State private var showPhotoEditor = false\
    @State private var selectedEvent: EventType = .hufschmied\
    @State private var showDatePickerPopup: Bool = false\
\
    @AppStorage("debugMode") private var debugMode = false\
    @AppStorage("debugMinutes") private var debugMinutes = 10.0\
\
    enum EventType \{\
        case hufschmied, impfung, wurmkur\
    \}\
\
    var body: some View \{\
        ScrollView \{\
            VStack(spacing: 15) \{\
                Image("hippominder_logo")\
                    .resizable().scaledToFit().frame(height: 50)\
\
                Text(horse.name).font(.title).bold()\
\
                HStack(spacing: 25) \{\
                    FlowerTimerView(symbol: "schmied", title: "Hufschmied", lastDate: horse.letzterHufpflegeTermin, interval: horse.hufpflegeIntervall, debugMode: debugMode, debugMinutes: Int(debugMinutes))\
                    FlowerTimerView(symbol: "spritze", title: "Impfung", lastDate: horse.letzterImpfTermin, interval: horse.impfungIntervall, debugMode: debugMode, debugMinutes: Int(debugMinutes))\
                    FlowerTimerView(symbol: "wurm", title: "Wurmkur", lastDate: horse.letzterWurmkurTermin, interval: horse.wurmkurIntervall, debugMode: debugMode, debugMinutes: Int(debugMinutes))\
                \}\
\
                Divider().padding(.vertical, 5)\
\
                HStack \{\
                    Text("Benachrichtigen in Tagen").font(.subheadline)\
                    Spacer()\
                    blinkingLED()\
                    customButton(icon: "minus") \{\
                        notificationDaysBefore = max(notificationDaysBefore - 1, 1)\
                    \}\
                    Text("\\(notificationDaysBefore)").frame(width: 30)\
                    customButton(icon: "plus") \{\
                        notificationDaysBefore = min(notificationDaysBefore + 1, 9)\
                    \}\
                \}\
\
                intervalRow("Hufschmied", interval: $horse.hufpflegeIntervall, event: .hufschmied)\
                intervalRow("Impfung", interval: $horse.impfungIntervall, event: .impfung)\
                intervalRow("Wurmkur", interval: $horse.wurmkurIntervall, event: .wurmkur)\
\
                if let horseImage \{\
                    horseImage.resizable().scaledToFit().cornerRadius(8)\
                \}\
\
                PhotosPicker("Pferdefoto ausw\'e4hlen", selection: $selectedPhoto, matching: .images)\
                    .buttonStyle(.borderedProminent)\
\
                Button("Nachrichten") \{\
                    // TODO: Nachrichten-Seite implementieren\
                \}.buttonStyle(.bordered)\
\
            \}.padding()\
        \}\
        .sheet(isPresented: $showDatePickerPopup) \{\
            DatePickerPopup(horse: horse, eventType: selectedEvent)\
        \}\
        .onChange(of: selectedPhoto) \{\
            Task \{\
                horseImage = try await selectedPhoto?.loadTransferable(type: Image.self)\
                showPhotoEditor = true\
            \}\
        \}\
    \}\
\
    func blinkingLED() -> some View \{\
        Circle().fill(.red).frame(width: 12, height: 12)\
            .opacity(0.7)\
            .animation(.easeInOut(duration: 0.8).repeatForever(autoreverses: true), value: UUID())\
    \}\
\
    func customButton(icon: String, action: @escaping ()->Void) -> some View \{\
        Button(action: action) \{\
            Image(icon).resizable().scaledToFit().frame(width: 34)\
        \}.buttonStyle(.plain)\
    \}\
\
    func intervalRow(_ title: String, interval: Binding<Int>, event: EventType) -> some View \{\
        HStack \{\
            Text(title).font(.subheadline)\
            Spacer()\
            customButton(icon: "kalender") \{\
                selectedEvent = event\
                showDatePickerPopup = true\
            \}\
            customButton(icon: "minus") \{ interval.wrappedValue -= 1 \}\
            TextField("", value: interval, format: .number).frame(width: 40).keyboardType(.numberPad)\
            customButton(icon: "plus") \{ interval.wrappedValue += 1 \}\
        \}\
    \}\
\}\
