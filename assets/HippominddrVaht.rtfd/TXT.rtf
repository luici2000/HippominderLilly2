\f8\i \cf11 // Wert zwischen 0.0 (kein Fortschritt) und 1.0 (Intervall vollst\'e4ndig)
\f9\i0 \cf12 \
    \cf13 var\cf12  lineWidth: \cf15 CGFloat\cf12      
\f8\i \cf11 // Breite des Kreisrandes
