                        .offset(y: -\cf15 20\cf12 )\
                        .rotationEffect(.degrees(\cf15 Double\cf12 (i) * \cf15 30\cf12 ))\
                \}\
            \}\
            \cf15 Text\cf12 (\cf18 "\cf19 \\(remainingDays)\cf18  Tage"\cf12 )\
                .foregroundColor(.black).font(.caption).bold()\
            \cf15 Text\cf12 (title).font(.caption2)\
            \cf15 Text\cf12 (targetDate, style: .date).font(.caption2).foregroundColor(.gray)\
        \}.frame(width: \cf15 90\cf12 )\
    \}\
\
    \cf13 func\cf12  \cf14 intervalStepper\cf12 (\cf13 _\cf12  title: \cf15 String\cf12 , interval: \cf15 Binding\cf12 <\cf15 Int\cf12 >) -> \cf13 some\cf12  \cf15 View\cf12  \{\
