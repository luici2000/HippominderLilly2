    \cf13 func\cf12  \cf14 blumenTimerView\cf12 (title: \cf15 String\cf12 , lastDate: \cf15 Date\cf12 , intervalDays: \cf15 Int\cf12 ) -> \cf13 some\cf12  \cf15 View\cf12  \{\
        \cf13 let\cf12  totalTime = \cf15 Double\cf12 (intervalDays * (debugMode ? \cf15 1\cf12  : \cf15 86400\cf12 ))\
        \cf13 let\cf12  elapsedTime = \cf15 Date\cf12 ().timeIntervalSince(lastDate)\
        \cf13 let\cf12  progress = \cf17 min\cf12 (\cf17 max\cf12 (elapsedTime / totalTime, \cf15 0\cf12 ), \cf15 1\cf12 )\
        \cf13 let\cf12  remainingDays = intervalDays - \cf15 Int\cf12 (elapsedTime / (debugMode ? \cf15 1\cf12  : \cf15 86400\cf12 ))\
        \cf13 let\cf12  dateText = lastDate.addingTimeInterval(totalTime).formatted(date: .numeric, time: .omitted)\
\
        \cf13 return\cf12  \cf15 VStack\cf12  \{\
            \cf15 ZStack\cf12  \{\
                \cf15 Image\cf12 (\cf18 "blumenblatt_leer"\cf12 )\
                    .resizable()\
