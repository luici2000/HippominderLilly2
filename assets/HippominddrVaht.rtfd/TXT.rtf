                    \}\
                \}\
\
                intervalRow(\cf18 "Hufschmied"\cf12 , interval: \cf15 $horse\cf12 .hufpflegeIntervall, event: .hufschmied)\
                intervalRow(\cf18 "Impfung"\cf12 , interval: \cf15 $horse\cf12 .impfungIntervall, event: .impfung)\
                intervalRow(\cf18 "Wurmkur"\cf12 , interval: \cf15 $horse\cf12 .wurmkurIntervall, event: .wurmkur)\
\
                \cf13 if\cf12  \cf13 let\cf12  horseImage \{\
