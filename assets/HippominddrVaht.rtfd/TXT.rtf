\
    \cf13 func\cf12  \cf14 fortschritt\cf12 (letzterTermin: \cf15 Date\cf12 , intervall: \cf15 Int\cf12 ) -> \cf15 Double\cf12  \{\
        \cf13 let\cf12  vergangeneTage = \cf15 Calendar\cf12 .current.dateComponents([.day], from: letzterTermin, to: \cf15 Date\cf12 ()).day ?? \cf15 0\cf12 \
        \cf13 return\cf12  \cf17 min\cf12 (\cf15 Double\cf12 (vergangeneTage) / \cf15 Double\cf12 (intervall), \cf15 1.0\cf12 )\
    \}\
\
    \cf13 var\cf12  tageBisHufpflege: \cf15 Int\cf12  \{\
        \cf17 max\cf12 (hufpflegeIntervall - (\cf15 Calendar\cf12 .current.dateComponents([.day], from: letzterHufpflegeTermin, to: \cf15 Date\cf12 ()).day ?? \cf15 0\cf12 ), \cf15 0\cf12 )\
    \}\
\
    \cf13 var\cf12  tageBisImpfung: \cf15 Int\cf12  \{\
        \cf17 max\cf12 (impfungIntervall - (\cf15 Calendar\cf12 .current.dateComponents([.day], from: letzterImpfTermin, to: \cf15 Date\cf12 ()).day ?? \cf15 0\cf12 ), \cf15 0\cf12 )\
    \}\
\
    \cf13 var\cf12  tageBisWurmkur: \cf15 Int\cf12  \{\
        \cf17 max\cf12 (wurmkurIntervall - (\cf15 Calendar\cf12 .current.dateComponents([.day], from: letzterWurmkurTermin, to: \cf15 Date\cf12 ()).day ?? \cf15 0\cf12 ), \cf15 0\cf12 )\
    \}\
\}\
