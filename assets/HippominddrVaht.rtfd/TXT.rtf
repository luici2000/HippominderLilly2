        tageBisZumNaechstenTermin(letzterTermin: letzterImpfTermin, intervall: impfungIntervall)\
    \}\
\
    \cf13 var\cf12  tageBisWurmkur: \cf15 Int\cf12  \{\
        tageBisZumNaechstenTermin(letzterTermin: letzterWurmkurTermin, intervall: wurmkurIntervall)\
    \}\
\
    
\f8\i \cf11 // Hilfsfunktion: Berechnet die Tage bis zum n\'e4chsten Termin auf Basis des letzten Termins und des Intervalls
\f9\i0 \cf12 \
    \cf13 private\cf12  \cf13 func\cf12  \cf14 tageBisZumNaechstenTermin\cf12 (letzterTermin: \cf15 Date\cf12 , intervall: \cf15 Int\cf12 ) -> \cf15 Int\cf12  \{\
        \cf13 let\cf12  kalender = \cf15 Calendar\cf12 .current\
        \cf13 let\cf12  naechsterTermin = kalender.date(byAdding: .day, value: intervall, to: letzterTermin)!\
        
\f8\i \cf11 // Differenz in Tagen zwischen heutigem Datum und n\'e4chstem Termin
\f9\i0 \cf12 \
        \cf13 let\cf12  tage = kalender.dateComponents([.day], from: \cf15 Date\cf12 (), to: naechsterTermin).day ?? \cf15 0\cf12 \
        \cf13 return\cf12  \cf17 max\cf12 (tage, \cf15 0\cf12 )\
    \}\
\
    
\f8\i \cf11 // Neue Methode: Fortschritt des Intervalls in Prozent (0.0 = frisch erledigt, 1.0 = komplett f\'e4llig)
\f9\i0 \cf12 \
    \cf13 func\cf12  \cf14 fortschritt\cf12 (letzterTermin: \cf15 Date\cf12 , intervall: \cf15 Int\cf12 ) -> \cf15 Double\cf12  \{\
        \cf13 let\cf12  gesamt = \cf15 Double\cf12 (intervall)\
        \cf13 let\cf12  verbleibend = \cf15 Double\cf12 (tageBisZumNaechstenTermin(letzterTermin: letzterTermin, intervall: intervall))\
        
\f8\i \cf11 // Berechnung: wie viel vom Intervall bereits vergangen ist (Zwischen 0.0 und 1.0)
\f9\i0 \cf12 \
        \cf13 let\cf12  abgelaufen = gesamt - verbleibend\
        \cf13 return\cf12  \cf17 max\cf12 (\cf17 min\cf12 (abgelaufen / gesamt, \cf15 1.0\cf12 ), \cf15 0.0\cf12 )\
    \}\
\}\
