\cf14 @Model\cf12 \
\cf13 class\cf12  \cf14 Horse\cf12  \{\
    \cf13 var\cf12  name: \cf15 String\cf12 \
    \cf13 var\cf12  hufpflegeIntervall: \cf15 Int\cf12 \
