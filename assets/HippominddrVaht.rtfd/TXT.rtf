\cf13 extension\cf12  \cf14 Horse\cf12  \{\
    
\f8\i \cf11 // Berechnete Eigenschaften: Tage bis zum n\'e4chsten Termin f\'fcr jede Kategorie
\f9\i0 \cf12 \
    \cf13 var\cf12  tageBisHufpflege: \cf15 Int\cf12  \{\
        tageBisZumNaechstenTermin(letzterTermin: letzterHufpflegeTermin, intervall: hufpflegeIntervall)\
