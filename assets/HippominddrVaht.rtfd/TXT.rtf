                                    lastDate: horse.letzterHufpflegeTermin, interval: horse.hufpflegeIntervall)\
                    \cf15 FlowerTimerView\cf12 (symbol: \cf18 "spritze"\cf12 , title: \cf18 "Impfung"\cf12 ,\
                                    lastDate: horse.letzterImpfTermin, interval: horse.impfungIntervall)\
                    \cf15 FlowerTimerView\cf12 (symbol: \cf18 "wurm"\cf12 , title: \cf18 "Wurmkur"\cf12 ,\
                                    lastDate: horse.letzterWurmkurTermin, interval: horse.wurmkurIntervall)\
                \}\
\
                \cf15 Divider\cf12 ().padding(.vertical, \cf15 10\cf12 )\
\
                \cf15 HStack\cf12  \{\
