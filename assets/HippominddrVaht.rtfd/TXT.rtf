    \cf13 var\cf12  letzterImpfTermin: \cf15 Date\cf12 \
    \cf13 var\cf12  letzterWurmkurTermin: \cf15 Date\cf12 \
    \
    \cf13 init\cf12 (name: \cf15 String\cf12 ,\
         hufpflegeIntervall: \cf15 Int\cf12 ,\
         impfungIntervall: \cf15 Int\cf12 ,\
         wurmkurIntervall: \cf15 Int\cf12 ,\
         letzterHufpflegeTermin: \cf15 Date\cf12 ,\
         letzterImpfTermin: \cf15 Date\cf12 ,\
         letzterWurmkurTermin: \cf15 Date\cf12 ) \{\
        \cf13 self\cf12 .name = name\
        \cf13 self\cf12 .hufpflegeIntervall = hufpflegeIntervall\
        \cf13 self\cf12 .impfungIntervall = impfungIntervall\
        \cf13 self\cf12 .wurmkurIntervall = wurmkurIntervall\
        \cf13 self\cf12 .letzterHufpflegeTermin = letzterHufpflegeTermin\
        \cf13 self\cf12 .letzterImpfTermin = letzterImpfTermin\
