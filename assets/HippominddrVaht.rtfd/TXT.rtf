        \cf13 let\cf12  progress = \cf17 min\cf12 (\cf17 max\cf12 (elapsed / total, \cf15 0\cf12 ), \cf15 1\cf12 )\
        \cf13 let\cf12  filledBlades = \cf15 Int\cf12 (progress * \cf15 12\cf12 )\
        \cf13 let\cf12  remainingDays = interval - \cf15 Int\cf12 (elapsed / \cf15 86400\cf12 )\
        \cf13 let\cf12  targetDate = last.addingTimeInterval(total)\
\
