    \cf13 private\cf12  \cf13 func\cf12  \cf14 flowerTimer\cf12 (symbol: \cf15 String\cf12 , title: \cf15 String\cf12 , lastDate: \cf15 Date\cf12 , interval: \cf15 Int\cf12 ) -> \cf13 some\cf12  \cf15 View\cf12  \{\
        \cf13 let\cf12  elapsedSeconds = \cf15 Date\cf12 ().timeIntervalSince(lastDate)\
        \cf13 let\cf12  elapsedDays = debugMode ? (elapsedSeconds / \cf15 Double\cf12 (debugMinutes * \cf15 60\cf12 )) : elapsedSeconds / \cf15 86400\cf12 \
        \cf13 let\cf12  filledBlades = \cf17 min\cf12 (\cf17 max\cf12 (\cf15 Int\cf12 (elapsedDays / \cf15 Double\cf12 (interval) * \cf15 12\cf12 ), \cf15 0\cf12 ), \cf15 12\cf12 )\
        \cf13 let\cf12  stempelFilled = filledBlades == \cf15 12\cf12  ? \cf18 "stempel_voll"\cf12  : \cf18 "stempel_leer"\cf12 \
\
        \cf13 return\cf12  \cf15 VStack\cf12 (spacing: \cf15 5\cf12 ) \{\
            \cf15 ZStack\cf12  \{\
                \cf15 ForEach\cf12 (\cf15 0\cf12 ..<\cf15 12\cf12 ) \{ i \cf13 in\cf12 \
                    \cf15 Image\cf12 (i < filledBlades ? \cf18 "blumenblatt_voll"\cf12  : \cf18 "blumenblatt_leer"\cf12 )\
                        .resizable()\
                        .frame(width: \cf15 30\cf12 , height: \cf15 80\cf12 )\
                        .rotationEffect(.degrees(\cf15 Double\cf12 (i) * \cf15 30\cf12 ))\
                \}\
                \cf15 Image\cf12 (stempelFilled)\
                    .resizable()\
                    .frame(width: \cf15 30\cf12 , height: \cf15 30\cf12 )\
            \}\
            .frame(width: \cf15 130\cf12 , height: \cf15 130\cf12 )\
\
            \cf15 Image\cf12 (systemName: symbol)\
                .font(.title2)\
                .foregroundColor(.gray)\
\
            \cf15 Text\cf12 (\cf18 "\cf19 \\(interval - Int(elapsedDays))\cf18  Tage"\cf12 )\
                .font(.caption).bold()\
\
            \cf15 Text\cf12 (title)\
                .font(.caption2)\
\
            \cf15 Text\cf12 (lastDate.addingTimeInterval(\cf15 Double\cf12 (interval) * \cf15 86400\cf12 ), style: .date)\
                .font(.caption2)\
                .foregroundColor(.gray)\
        \}\
    \}\
\
    \cf13 private\cf12  \cf13 func\cf12  \cf14 intervalStepper\cf12 (\cf13 _\cf12  title: \cf15 String\cf12 , interval: \cf15 Binding\cf12 <\cf15 Int\cf12 >) -> \cf13 some\cf12  \cf15 View\cf12  \{\
