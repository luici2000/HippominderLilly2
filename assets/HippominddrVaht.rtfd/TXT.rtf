                    \}\
                    \cf15 Text\cf12 (\cf18 "\cf19 \\(notificationDaysBefore)\cf18 "\cf12 ).frame(width: \cf15 30\cf12 )\
                    customButton(icon: \cf18 "plus"\cf12 ) \{\
