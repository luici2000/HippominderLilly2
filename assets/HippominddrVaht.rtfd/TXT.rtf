\f9\fs28 \cf13 \cb2 func\cf12  \cf14 flowerTimer\cf12 (title: \cf15 String\cf12 , last: \cf15 Date\cf12 , interval: \cf15 Int\cf12 ) -> \cf13 some\cf12  \cf15 View\cf12  \{\
    \cf13 let\cf12  elapsedDays = \cf15 Int\cf12 (\cf15 Date\cf12 ().timeIntervalSince(last) / \cf15 86400\cf12 )\
    \cf13 let\cf12  progress = \cf15 Double\cf12 (elapsedDays) / \cf15 Double\cf12 (interval)\
    \cf13 let\cf12  remainingDays = interval - elapsedDays\
    \cf13 let\cf12  targetDate = \cf15 Calendar\cf12 .current.date(byAdding: .day, value: interval, to: last) ?? \cf15 Date\cf12 ()\
\
    \cf13 return\cf12  \cf15 VStack\cf12  \{\
        \cf15 ZStack\cf12  \{\
            
\f8\i \cf11 // Hintergrundbild (leere Blume)
\f9\i0 \cf12 \
            \cf15 Image\cf12 (\cf18 "blume_leer"\cf12 )\
                .resizable()\
                .scaledToFit()\
                .frame(width: \cf15 60\cf12 , height: \cf15 60\cf12 )\
\
            
\f8\i \cf11 // Vordergrund (gef\'fcllte Blume), mit radialem Fortschritt maskiert
\f9\i0 \cf12 \
            \cf15 Image\cf12 (\cf18 "blume_voll"\cf12 )\
                .resizable()\
                .scaledToFit()\
                .frame(width: \cf15 60\cf12 , height: \cf15 60\cf12 )\
                .mask(\
                    \cf15 Circle\cf12 ()\
                        .trim(from: \cf15 0.0\cf12 , to: \cf15 CGFloat\cf12 (progress))\
                        .rotation(.degrees(-\cf15 90\cf12 ))\
                        .scale(\cf15 1.1\cf12 )\
                )\
        \}\
        .frame(width: \cf15 60\cf12 , height: \cf15 60\cf12 )\
\
        \cf15 Text\cf12 (\cf18 "\cf19 \\(remainingDays)\cf18  Tage"\cf12 )\
            .foregroundColor(.black)\
            .font(.caption).bold()\
\
        \cf15 Text\cf12 (title)\
            .font(.caption2)\
\
        \cf15 Text\cf12 (targetDate, style: .date)\
            .font(.caption2)\
            .foregroundColor(.gray)\
    \}\
    .frame(width: \cf15 90\cf12 )\
\}\
