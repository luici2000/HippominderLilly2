                .foregroundColor(remainingDays > \cf15 5\cf12  ? .green : remainingDays > \cf15 1\cf12  ? .orange : .red)\
                .font(.caption).bold()\
            \cf15 Text\cf12 (title)\
                .font(.caption2)\
            \cf15 Text\cf12 (dateText)\
                .font(.caption2).foregroundColor(.gray)\
        \}\
    \}\
